logging {
    level = "info"
}

loki.write "default" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}

// Centrale filter om tijd-gezeur te voorkomen
loki.process "force_now" {
    forward_to = [loki.write.default.receiver]
    stage.timestamp {
        source = "now"
        format = "RFC3339"
    }
}

// BRON 1: NPM Honeypot
local.file_match "npm_logs" {
    path_targets = [{
        "__address__" = "localhost",
        // Gebruik **/ om ook in submappen te zoeken
        "filename"    = "/var/log/npm/**/*_access.log",
        "job"         = "npm_honeypot",
    }]
}

// BRON 2: Nextcloud
local.file_match "nextcloud_logs" {
    path_targets = [{
        "__address__" = "localhost",
        // We zoeken nu overal in /data/data naar .log bestanden
        "filename"    = "/data/data/**/*.log",
        "job"         = "nextcloud",
    }]
}

loki.source.file "npm_scrape" {
    targets    = local.file_match.npm_logs.targets
    forward_to = [loki.process.force_now.receiver]
}

// BRON 2: Nextcloud
local.file_match "nextcloud_logs" {
    path_targets = [{
        "__address__" = "localhost",
        // We zoeken nu overal in /data/data naar .log bestanden
        "filename"    = "/data/data/**/*.log",
        "job"         = "nextcloud",
    }]
}

loki.source.file "nextcloud_scrape" {
    targets    = local.file_match.nextcloud_logs.targets
    forward_to = [loki.process.force_now.receiver]
}
