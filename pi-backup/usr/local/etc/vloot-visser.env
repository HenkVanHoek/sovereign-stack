# --- Matrix Vloot Configuratie ---
BACKUP_USER="hvhoek"
SOURCE_NODE="100.107.250.88"
DB_CONTAINER="synapse_db"
DB_USER="synapse"
BACKUP_ROOT="/mnt/backup_pi_lenovo/lenovo_vms/synapse"
RETENTION_DAYS=14
LOG_FILE="/mnt/backup_pi_lenovo/logs/visser.log"

# --- Signal & Monitoring ---
SIGNAL_API="http://100.73.81.103:8090/v2/send"
SIGNAL_SENDER="+31651107603" # Jouw Signal nummer in de container
SIGNAL_RECIPIENT="+31651107603" # Jouw mobiele nummer
DISK_LIMIT_GB=50 # Waarschuwing als er minder dan 50GB vrij is

# --- E-mail Instellingen ---
ADMIN_EMAIL="hvh@freedom.nl"
MAIL_SUBJECT="[Pi-Backup] Rapportage Matrix Vloot"

# De vloot: Lijst van Mesh-IP's van de Matrix VM's:
# synapse-familie, synapse (liberalevrienden.social) en piselfhosting.com
MATRIX_NAMES=("synapse-familie" "liberalevrienden" "piselfhosting")
MATRIX_NODES=("100.76.178.28" "100.107.250.88" "100.108.63.140")

# De locaties: Overeenkomstige Docker-config paden OP die VM's
MATRIX_CONF_PATHS=(
    "/home/hvhoek/docker/synapse/synapse_data"
    "/home/hvhoek/docker/synapse/synapse_data"
    "/home/hvhoek/docker/synapse/synapse_data"
)

# Bestemming op de 2TB HDD (Pi-Backup)
LOCAL_BACKUP_BASE="/mnt/backup_pi_lenovo/remote_synapse"
DEST_DIR="/mnt/backup_pi_lenovo/remote_synapse"

